#: data/org.gnome.TextEditor.metainfo.xml.in.in:10
#: src/editor-application-actions.c:200 src/editor-window.c:1288
msgid "Text Editor"
msgstr "Mətn redaktoru"

#: data/org.gnome.TextEditor.desktop.in.in:9
msgid "View and edit text files"
msgstr "Mətn fayllarına baxın və redaktə edin"

#: data/org.gnome.TextEditor.desktop.in.in:21
msgid "New Window"
msgstr "Yeni pəncərə"

#: data/org.gnome.TextEditor.metainfo.xml.in.in:12
msgid "Edit text files"
msgstr "Mətn fayllarını redaktə et"

#: data/org.gnome.TextEditor.metainfo.xml.in.in:14
msgid ""
"GNOME Text Editor is a simple text editor focused on a pleasing default "
"experience."
msgstr ""
"GNOME Mətn redaktoru, xoş bir standart təcrübəyə yönəlmiş sadə bir mətn "
"redaktorudur."

#: data/org.gnome.TextEditor.metainfo.xml.in.in:27
msgid "Text Editor's main window"
msgstr "Mətn redaktorunun əsas pəncərəsi"

#: data/org.gnome.TextEditor.metainfo.xml.in.in:31
msgid "Syntax highlighting"
msgstr "Sintaksis vurğulaması"

#: data/org.gnome.TextEditor.gschema.xml:16
msgid "Auto Save Delay"
msgstr "Avtomatik yadda saxlamanın gecikməsi"

#: data/org.gnome.TextEditor.gschema.xml:17
msgid "The delay in seconds to wait before auto-saving a draft."
msgstr ""
"Qaralamanın avtomatik yadda saxlanılmasından əvvəl gözləniləcək saniyələr."

#: data/org.gnome.TextEditor.gschema.xml:26
msgid "Style Variant"
msgstr "Stil variantı"

#: data/org.gnome.TextEditor.gschema.xml:27
msgid ""
"Use the light or dark variant of the GTK theme and/or GtkSourceView style "
"scheme."
msgstr ""
"GTK mövzusu və/və ya GtkSourceView üslub sxeminin açıq və ya tünd "
"variantından istifadə edin."

#: data/org.gnome.TextEditor.gschema.xml:35
msgid "Indentation Style"
msgstr "Abzas üslubu"

#: data/org.gnome.TextEditor.gschema.xml:36
msgid ""
"Whether the editor should insert multiple spaces characters instead of tabs."
msgstr ""
"Redaktorun tab simvolları əvəzinə bir neçə boşluq simvolu əlavə edib-"
"etməməsi."

#: data/org.gnome.TextEditor.gschema.xml:40
msgid "Auto Indent"
msgstr "Avtomatik abzaslama"

#: data/org.gnome.TextEditor.gschema.xml:41
msgid ""
"Automatically indent new lines copying the previous line's indentation."
msgstr ""
"Əvvəlki sətrin abzasını əsas götürərək yeni sətirləri avtomatik abzaslayın."

#: data/org.gnome.TextEditor.gschema.xml:46
msgid "Tab Width"
msgstr "Vərəqə eni"

#: data/org.gnome.TextEditor.gschema.xml:47
msgid "The number of spaces represented by a tab."
msgstr "Vərəqə ilə təmsil olunan boşluqların sayı."

#: data/org.gnome.TextEditor.gschema.xml:52
msgid "Indent Width"
msgstr "Abzas eni"

#: data/org.gnome.TextEditor.gschema.xml:53
msgid "The number of spaces to indent or -1 to use tab-width."
msgstr ""
"Abzas üçün boşluqların sayı. Vərəqə enini istifadə etmək üçün -1 daxil edin."

#: data/org.gnome.TextEditor.gschema.xml:57
msgid "Show Line Numbers"
msgstr "Sətir nömrələrini göstər"

#: data/org.gnome.TextEditor.gschema.xml:58
msgid "Whether line numbers should be displayed next to each line."
msgstr "Hər sətrin yanında sətir nömrələrinin göstərilib-göstərilməməsi."

#: data/org.gnome.TextEditor.gschema.xml:62
msgid "Show Right Margin"
msgstr "Sağ kənar boşluğu göstər"

#: data/org.gnome.TextEditor.gschema.xml:63
msgid "Whether a margin line should be displayed on the right of the editor."
msgstr ""
"Redaktorun sağ tərəfində kənar boşluğu xəttinin göstərilib-göstərilməyəcəyi."

#: data/org.gnome.TextEditor.gschema.xml:68
msgid "Right Margin Position"
msgstr "Sağ kənar boşluğu mövqeyi"

#: data/org.gnome.TextEditor.gschema.xml:69
msgid ""
"The position in characters at which the right margin should be displayed."
msgstr "Sağ kənar boşluğun göstərilməli olduğu simvol mövqeyi."

#: data/org.gnome.TextEditor.gschema.xml:73
msgid "Show Overview Map"
msgstr "İcmal xəritəsini göstər"

#: data/org.gnome.TextEditor.gschema.xml:74
msgid ""
"If enabled, an overview map of the file will be displayed to the side of the "
"editor."
msgstr ""
"Aktiv edildikdə faylın icmal xəritəsi redaktorun yanında göstəriləcək."

#: data/org.gnome.TextEditor.gschema.xml:78
msgid "Show Background Grid"
msgstr "Arxa plan torunu göstər"

#: data/org.gnome.TextEditor.gschema.xml:79
msgid ""
"If enabled, a blueprint style grid is printed on the editor background."
msgstr ""
"Aktiv edildikdə redaktorun arxa fonunda çertyoj üslub toru çap olunur."

#: data/org.gnome.TextEditor.gschema.xml:83
msgid "Highlight current line"
msgstr "Hazırkı sətri vurğula"

#: data/org.gnome.TextEditor.gschema.xml:84
msgid "If enabled, the current line will be highlighted."
msgstr "Aktiv edildikdə hazırki xətt vurğulanacaq."

#: data/org.gnome.TextEditor.gschema.xml:88
msgid "Text Wrapping"
msgstr "Mətn bükmə"

#: data/org.gnome.TextEditor.gschema.xml:89
msgid "Whether text should be wrapped."
msgstr "Mətnin bükülüb-bükülməyəcəyi."

#: data/org.gnome.TextEditor.gschema.xml:93
msgid "Use System Font"
msgstr "Sistem şriftindən istifadə et"

#: data/org.gnome.TextEditor.gschema.xml:94
msgid "Whether the default system monospace font should be used."
msgstr "Sistemin \"monospace\" şriftinin istifadə olunub-olunmayacağı."

#: data/org.gnome.TextEditor.gschema.xml:98
msgid "Custom Font"
msgstr "Fərdi şrift"

#: data/org.gnome.TextEditor.gschema.xml:99
msgid "A custom font to use in the editor."
msgstr "Redaktorda istifadə ediləcək fərdi şrift."

#: data/org.gnome.TextEditor.gschema.xml:103
msgid "Style Scheme"
msgstr "Üslub sxemi"

#: data/org.gnome.TextEditor.gschema.xml:104
msgid ""
"The style scheme to use by the editor. It may translate this into a dark "
"format when available."
msgstr ""
"Redaktor tərəfindən istifadə ediləcək üslub sxemi. Əlçatan olduqda bunu tünd "
"formata çevirə bilər."

#: data/org.gnome.TextEditor.gschema.xml:108
msgid "Discover File Settings"
msgstr "Fayl ayarlarını aşkar et"

#: data/org.gnome.TextEditor.gschema.xml:109
msgid ""
"If enabled, then Text Editor will try to discover file settings from "
"modelines, editorconfig, or per-language defaults."
msgstr ""
"Aktiv edildikdə Mətn redaktoru fayl ayarlarını \"modelines\", "
"\"editorconfig\" və ya dil üzrə varsayılanlardan aşkar etməyə çalışacaq."

#: data/org.gnome.TextEditor.gschema.xml:113
msgid "Automatically check spelling"
msgstr "Orfoqrafiyanı avtomatik yoxla"

#: data/org.gnome.TextEditor.gschema.xml:114
msgid "If enabled, then Text Editor will check spelling as you type."
msgstr "Aktiv edildikdə Mətn redaktou siz yazdıqca orfoqrafiyanı yoxlayacaq."

#: data/org.gnome.TextEditor.gschema.xml:118
msgid "Restore session"
msgstr "Oturumu bərpa et"

#: data/org.gnome.TextEditor.gschema.xml:119
msgid "When Text Editor is running, restore the previous session."
msgstr "Mətn redaktoru çalışarkən öncəki oturumu bərpa et."

#: data/org.gnome.TextEditor.gschema.xml:123
msgid "Recolor Window"
msgstr "Pəncərəni yenidən rənglə"

#: data/org.gnome.TextEditor.gschema.xml:124
msgid "Use the style-scheme to recolor the application window."
msgstr ""
"Tətbiq pəncərəsini yenidən rəngləmək üçün üslub sxemindən istifadə et."

#: data/org.gnome.TextEditor.gschema.xml:132
msgid "Keybindings"
msgstr "Klaviatura əlaqələri"

#: data/org.gnome.TextEditor.gschema.xml:133
msgid "The keybindings to use within Text Editor."
msgstr "Mətn redaktorunda istifadə ediləcək klaviatura əlaqələri."

#: data/org.gnome.TextEditor.gschema.xml:137
msgid "Last Save Directory"
msgstr "Son saxlama kataloqu"

#: data/org.gnome.TextEditor.gschema.xml:138
msgid "The directory last used in a save or save-as dialog."
msgstr "Saxla və ya fərqli saxla dialoqunda sonuncu istifadə edilən kataloq."

#: data/org.gnome.TextEditor.gschema.xml:142
msgid "Draw Spaces"
msgstr "Boşluq çək"

#: data/org.gnome.TextEditor.gschema.xml:143
msgid "The various types of spaces to draw in the editor."
msgstr "Redaktorda göstəriləcək müxtəlif boşluq növləri."

#: data/org.gnome.TextEditor.gschema.xml:147
msgid "Enable Snippets"
msgstr "Parçacıqları aktiv et"

#: data/org.gnome.TextEditor.gschema.xml:148
msgid ""
"Enable the use of snippets registered with GtkSourceView from within the "
"editor."
msgstr ""
"Redaktor daxilində GtkSourceView ilə qeydiyyatdan keçmiş parçacıqların "
"istifadəsini aktivləşdir."

#: data/org.gnome.TextEditor.gschema.xml:153
msgid "Line Height"
msgstr "Sətir hündürlüyü"

#: data/org.gnome.TextEditor.gschema.xml:154
msgid "The line height to use for the selected font."
msgstr "Seçilmiş şrift üçün sətir hündürlüyü"

#: data/org.gnome.TextEditor.gschema.xml:158
msgid "Highlight Matching Brackets"
msgstr "Uyğunlaşan mötərizələri vurğula"

#: data/org.gnome.TextEditor.gschema.xml:159
msgid "Highlight matching brackets and braces."
msgstr "Uyğun gələn mötərizələri və fiqurlu mötərizələri vurğula."

