<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="EditorSearchBar" parent="GtkWidget">
    <style>
      <class name="searchbar"/>
    </style>
    <child>
      <object class="AdwBreakpointBin">
        <property name="width-request">250</property>
        <property name="height-request">40</property>
        <child>
          <object class="AdwBreakpoint">
            <condition>max-width: 500sp</condition>
            <setter object="layouts" property="layout-name">narrow</setter>
          </object>
        </child>
        <child>
          <object class="AdwMultiLayoutView" id="layouts">
            <child type="search_entry">
              <object class="EditorSearchEntry" id="search_entry">
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkEventControllerKey">
                    <property name="propagation-phase">capture</property>
                    <signal name="key-pressed" handler="on_search_key_pressed_cb"/>
                  </object>
                </child>
              </object>
            </child>
            <child type="replace_entry">
              <object class="GtkEntry" id="replace_entry">
                <property name="primary-icon-name">edit-find-replace-symbolic</property>
                <property name="max-width-chars">20</property>
                <property name="hexpand">true</property>
                <property name="visible">false</property>
                <property name="placeholder-text" translatable="yes">Replace</property>
                <accessibility>
                  <property name="label" translatable="yes">Replace</property>
                </accessibility>
              </object>
            </child>
            <child type="navigation">
              <object class="GtkBox">
                <property name="homogeneous">true</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">3</property>
                <property name="hexpand">false</property>
                <child>
                  <object class="GtkButton" id="move_previous">
                    <property name="hexpand">true</property>
                    <property name="action-name">search.move-previous</property>
                    <property name="action-target">false</property>
                    <property name="tooltip-text" translatable="yes">Previous Match</property>
                    <property name="icon-name">go-up-symbolic</property>
                    <property name="focus-on-click">false</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="move_next">
                    <property name="hexpand">true</property>
                    <property name="action-name">search.move-next</property>
                    <property name="action-target">false</property>
                    <property name="tooltip-text" translatable="yes">Next Match</property>
                    <property name="icon-name">go-down-symbolic</property>
                    <property name="focus-on-click">false</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child type="replace_mode_button">
              <object class="GtkToggleButton" id="replace_mode_button">
                <property name="tooltip-text" translatable="yes">Search &amp; Replace</property>
                <property name="icon-name">edit-find-replace-symbolic</property>
                <property name="focus-on-click">false</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child type="options_button">
              <object class="GtkMenuButton" id="options_button">
                <property name="direction">up</property>
                <property name="tooltip-text" translatable="yes">Search Options</property>
                <property name="icon-name">emblem-system-symbolic</property>
                <property name="menu-model">options_menu</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child type="close_button">
              <object class="GtkButton" id="close_button">
                <property name="margin-end">3</property>
                <property name="action-name">search.hide</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Close Search</property>
                <property name="icon-name">window-close-symbolic</property>
                <property name="focus-on-click">false</property>
                <style>
                  <class name="flat"/>
                  <class name="small-button"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
            <child type="replace_button">
              <object class="GtkButton" id="replace_button">
                <property name="action-name">search.replace-one</property>
                <property name="use-underline">true</property>
                <property name="label" translatable="yes">_Replace</property>
                <property name="visible">false</property>
                <property name="focus-on-click">false</property>
                <property name="can-shrink">True</property>
              </object>
            </child>
            <child type="replace_all_button">
              <object class="GtkButton" id="replace_all_button">
                <property name="action-name">search.replace-all</property>
                <property name="use-underline">true</property>
                <property name="label" translatable="yes">Replace _All</property>
                <property name="visible">false</property>
                <property name="focus-on-click">false</property>
                <property name="can-shrink">True</property>
              </object>
            </child>
            <child>
              <object class="AdwLayout">
                <property name="name">wide</property>
                <property name="content">
                  <object class="GtkGrid" id="grid">
                    <style>
                      <class name="toolbar"/>
                    </style>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">search_entry</property>
                        <layout>
                          <property name="row">0</property>
                          <property name="column">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_entry</property>
                        <layout>
                          <property name="row">1</property>
                          <property name="column">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">navigation</property>
                        <layout>
                          <property name="row">0</property>
                          <property name="column">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_mode_button</property>
                        <layout>
                          <property name="row">0</property>
                          <property name="column">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">options_button</property>
                        <layout>
                          <property name="row">0</property>
                          <property name="column">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">close_button</property>
                        <layout>
                          <property name="row">0</property>
                          <property name="column">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_button</property>
                        <layout>
                          <property name="row">1</property>
                          <property name="column">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_all_button</property>
                        <layout>
                          <property name="row">1</property>
                          <property name="column">2</property>
                          <property name="column-span">3</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwLayout">
                <property name="name">narrow</property>
                <property name="content">
                  <object class="GtkGrid">
                    <style>
                      <class name="toolbar"/>
                    </style>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">search_entry</property>
                        <layout>
                          <property name="row">0</property>
                          <property name="column">0</property>
                          <property name="column-span">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_entry</property>
                        <layout>
                          <property name="row">1</property>
                          <property name="column">0</property>
                          <property name="column-span">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">navigation</property>
                        <layout>
                          <property name="row">2</property>
                          <property name="column">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_mode_button</property>
                        <layout>
                          <property name="row">2</property>
                          <property name="column">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">options_button</property>
                        <layout>
                          <property name="row">2</property>
                          <property name="column">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">close_button</property>
                        <layout>
                          <property name="row">2</property>
                          <property name="column">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_button</property>
                        <layout>
                          <property name="row">3</property>
                          <property name="column">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="AdwLayoutSlot">
                        <property name="id">replace_all_button</property>
                        <layout>
                          <property name="row">3</property>
                          <property name="column">1</property>
                          <property name="column-span">3</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
  <menu id="options_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Re_gular Expressions</attribute>
        <attribute name="action">search-options.regex</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Case Sensitive</attribute>
        <attribute name="action">search-options.case-sensitive</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Match Whole _Word Only</attribute>
        <attribute name="action">search-options.match-whole-word</attribute>
      </item>
    </section>
  </menu>
</interface>
